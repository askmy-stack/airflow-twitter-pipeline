# Source selection. Use exactly one source path for local file ingestion.
FIXTURE_TWEETS_PATH=examples/sample_tweets.jsonl
XQUIK_TWEETS_PATH=

# Output artifacts.
OUTPUT_CSV_PATH=outputs/refined_tweets.csv
OUTPUT_JSONL_PATH=outputs/enriched_tweets.jsonl
OUTPUT_JSON_PATH=outputs/enriched_tweets.json

# Optional model-agnostic AI enrichment. Defaults to deterministic local rules.
# Providers: local, openai, anthropic, ollama, huggingface, vllm, lmstudio,
# together, groq, fireworks, openai_compatible.
AI_PROVIDER=local
AI_ENRICHMENT_MODE=local
AI_MODEL=local-rule-enricher-v1
AI_API_KEY=
AI_BASE_URL=

# Legacy OpenAI variables are still accepted when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# Twitter/X API fallback. Required only when no fixture or Xquik path is set.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_SCREEN_NAME=@elonmusk
TWITTER_MAX_COUNT=200
